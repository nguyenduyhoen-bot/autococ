<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.cat.af" ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="CAT AF" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.cat.af.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects support from CC 2020 through 2026+ -->
            <Host Name="AEFT" Version="[17.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.cat.af.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/AfterEffects.jsx</ScriptPath>
                    <CEPEngineRefs>
                        <CEPEngineRef Id="Node.js" />
                    </CEPEngineRefs>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>CAT AF - AI Motion & JSX Generator</Menu>
                    <Geometry>
                        <Size>
                            <Height>760</Height>
                            <Width>420</Width>
                        </Size>
                        <MinSize>
                            <Height>550</Height>
                            <Width>320</Width>
                        </MinSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>

