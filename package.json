{
  "name": "cat-ecosystem",
  "version": "1.1.4",
  "description": "CAT Ecosystem - Adobe Premiere Pro & After Effects Extension Manager",
  "author": "CAT Ecosystem <support@catmanager.com>",
  "scripts": {
    "build": "npm run --prefix desktop-app build",
    "build:win": "npm run --prefix desktop-app build:win",
    "build:mac": "npm run --prefix desktop-app build:mac",
    "desktop": "npm run --prefix desktop-app start",
    "web:build": "npm run --prefix web build",
    "secure:check-source": "node SECURE-BUILD/scripts/runner.js check-source",
