    "secure:build": "node SECURE-BUILD/scripts/runner.js build",
    "secure:obfuscate": "node SECURE-BUILD/scripts/runner.js obfuscate",
    "secure:setup": "node SECURE-BUILD/scripts/runner.js setup",
    "secure:patch": "node SECURE-BUILD/scripts/runner.js patch",
    "secure:sign": "node SECURE-BUILD/scripts/runner.js sign",
    "secure:verify": "node SECURE-BUILD/scripts/runner.js verify",
    "secure:release": "node SECURE-BUILD/scripts/runner.js release",
    "secure:all": "node SECURE-BUILD/scripts/runner.js all"
